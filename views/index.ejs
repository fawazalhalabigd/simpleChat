<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Authenticated Chat</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #f4f4f9;
      color: #333;
      padding: 12px;
      max-width: 650px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    h2 {
      text-align: center;
      margin: 10px 0 15px;
      font-size: 1.5rem;
    }

    #chat-box {
      flex: 1;
      height: 60vh;
      min-height: 300px;
      max-height: 500px;
      overflow-y: auto;
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 12px;
      background: #fff;
      margin-bottom: 15px;
      box-shadow: inset 0 1px 3px rgba(0,0,0,0.05);
    }

    .msg-card {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 8px 12px;
      background: #f8f9fa;
      border-radius: 6px;
      margin-bottom: 10px;
    }

    .msg-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .msg-user {
      font-weight: bold;
      color: #2563eb;
      font-size: 0.95rem;
    }

    .msg-time {
      font-size: 0.75rem;
      color: #6b7280;
      background: none;
    }

    .msg-body {
      font-size: 1rem;
      word-break: break-word;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 10px;
      background: #fff;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid #ddd;
    }

    .row {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    /* Standardized Touch Targets for Mobile */
    input, select, button {
      padding: 12px;
      font-size: 1rem;
      border: 1px solid #ccc;
      border-radius: 6px;
      width: 100%;
      outline: none;
    }

    input:focus, select:focus {
      border-color: #2563eb;
    }

    button[type="submit"] {
      background-color: #2563eb;
      color: #fff;
      font-weight: bold;
      border: none;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    button[type="submit"]:active {
      background-color: #1d4ed8;
    }

    .error-msg {
      color: #dc2626;
      background: #fee2e2;
      border: 1px solid #fca5a5;
      padding: 10px;
      border-radius: 6px;
      font-size: 0.9rem;
      margin-bottom: 10px;
      display: none;
    }

    /* Tablet & Desktop Layout Enhancements */
    @media (min-width: 500px) {
      body { padding: 30px 15px; }
      .row { flex-direction: row; }
      .msg-card { flex-direction: row; justify-content: space-between; align-items: baseline; }
    }
  </style>
</head>
<body>
  <h2>Global Chat</h2>

  <div id="chat-box">
    <% messages.forEach(msg => { %>
      <div class="msg-card">
        <div>
          <span class="msg-user"><%= msg.username %>:</span> 
          <span class="msg-body"><%= msg.text %></span>
        </div>
        <code class="msg-time"><%= new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></code>
      </div>
    <% }) %>
  </div>

  <div id="error" class="error-msg"></div>

  <form id="msg-form">
    <div class="row">
      <!-- Select registered user -->
      <select id="username" required>
        <option value="">-- Select User --</option>
        <% users.forEach(user => { %>
          <option value="<%= user.name %>"><%= user.name %></option>
        <% }) %>
      </select>

      <!-- Password input -->
      <input type="password" id="password" placeholder="Password" required>
    </div>

    <div class="row">
      <input type="text" id="text" placeholder="Type a message..." required autocomplete="off">
      <button type="submit">Send</button>
    </div>
  </form>

  <script>
    const chatBox = document.getElementById('chat-box');
    const form = document.getElementById('msg-form');
    const errorDiv = document.getElementById('error');

    // Auto-scroll chat to bottom on initial render
    chatBox.scrollTop = chatBox.scrollHeight;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorDiv.style.display = 'none';

      const username = document.getElementById('username').value;
      const password = document.getElementById('password').value;
      const text = document.getElementById('text').value;

      const res = await fetch('/api/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password, text })
      });

      const data = await res.json();

      if (!res.ok) {
        errorDiv.innerText = data.error || 'Failed to send message.';
        errorDiv.style.display = 'block';
        return;
      }

      document.getElementById('text').value = '';
      await fetchMessages();
      chatBox.scrollTop = chatBox.scrollHeight;
    });

    async function fetchMessages() {
      const res = await fetch('/api/messages');
      const messages = await res.json();
      
      // Save scroll state before DOM update
      const isAtBottom = chatBox.scrollHeight - chatBox.clientHeight <= chatBox.scrollTop + 50;

      chatBox.innerHTML = messages.map(m => `
        <div class="msg-card">
          <div>
            <span class="msg-user">${m.username}:</span> 
            <span class="msg-body">${m.text}</span>
          </div>
          <code class="msg-time">${new Date(m.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</code>
        </div>
      `).join('');

      // Auto-scroll only if user is already at the bottom
      if (isAtBottom) {
        chatBox.scrollTop = chatBox.scrollHeight;
      }
    }

    async function editMsg(id, oldText) {
      const newText = prompt('Edit:', oldText);
      if (!newText) return;
      await fetch('/api/messages/update/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: newText })
      });
      fetchMessages();
    }

    async function deleteMsg(id) {
      if (!confirm('Delete message?')) return;
      await fetch('/api/messages/delete/' + id, { method: 'POST' });
      fetchMessages();
    }

    setInterval(fetchMessages, 5000);
  </script>
</body>
</html>